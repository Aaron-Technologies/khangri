@using Khangri.Entities
@model List<EntityNewsLetterContactEmail>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "News Letters";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">News Letter</h4>
        </div>

        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_NewsLetter" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">News Letter Mail</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">@item.NewsLetterContactEmail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tbl_NewsLetter').DataTable({
                pageLength: 10
            });
        });
    </script>
}

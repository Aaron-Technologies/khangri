@using Khangri.Entities
@model EntityUser
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New User";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Add User</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>User Type<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m=>m.UserTypeId, (ViewBag.AllUserType as IEnumerable<SelectListItem>),new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.UserTypeId,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>First Name<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.FName, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.FName,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Last Name<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.LName, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.LName,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Email<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Email, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Email,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Mobile<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Mobile, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Mobile,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Password<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.PasswordFor(m=>m.Password,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Password,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>

                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","User")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>

                    }
                </div>


            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>
        $(document).ready(function () {



        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                                    var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "success",
                        button: "Ok",
                    }, function () {
                        var url = $.trim('@Url.Action("list","User")');
                        window.location.href = url;
                    });
                }
            }
        });
    </script>
}
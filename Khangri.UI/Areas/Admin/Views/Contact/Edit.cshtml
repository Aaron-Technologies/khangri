@using Khangri.Entities;
@model EntityContact;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Contact";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Edit Contact</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Header<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Header, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Header,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Phone<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Phone, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Phone,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Email<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Email, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Email,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Address<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Address, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Address,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Active:</span>
                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","Contact")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>

                    }
                </div>


            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>
        $(document).ready(function () {



        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                            var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","Contact")');
                            window.location.href = url;
                    });
                }
            }
        });
    </script>
}
@using Khangri.Entities
@model List<EntityContact>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Contact";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">Contact</h4>
            <a href="@Url.Action("add","Contact")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>

        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_Contact" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">Header</th>
                            <th class="fw-bold">Phone/Email</th>
                            <th class="fw-bold">Address</th>
                            <th class="fw-bold">Status</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">@contact.Header</td>
                                <td>
                                    @contact.Phone<br/>
                                    @contact.Email
                                </td>
                                <td class="align-middle">@contact.Address</td>

                                <td class="align-middle">
                                    @if (contact.IsActive)
                                    {
                                        <span class="badge light badge-success p-5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge light badge-danger p-5">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <a href="@Url.Action("edit","Contact",new {contactId = contact.ContactId})" class="btn btn-primary btn-sm"><i class="fa  fa-pencil-square fa-2x"></i></a>
                                        @* <button data-deleteurl="@Url.Action("delete","ShipType",new {ShipTypeId = ship.ShipTypeId})" class="btn btn-danger shadow btn-xs sharp btn-delete"><i class="fas fa-trash-alt"></i></button>*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tbl_Contact').DataTable({
                pageLength: 10
            });
        });
    </script>
}

@using Khangri.Entities
@model EntityChangePassword
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Change Password";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Change Password</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Old Password<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.PasswordFor(m=>m.OldPassword,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.OldPassword,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>New Password<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.PasswordFor(m=>m.NewPassword,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.NewPassword,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                      
                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("Profile","Account")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>

                    }
                </div>


            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>
        $(document).ready(function () {



        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                                            var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "success",
                        button: "Ok",
                    }, function () {
                        var url = $.trim('@Url.Action("Profile","Account")');
                        window.location.href = url;
                    });
                }
            }
        });
    </script>
}
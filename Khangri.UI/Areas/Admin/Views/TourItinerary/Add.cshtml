@using Khangri.Entities;
@model EntityTourItinerary;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New TourItinerary";
}
@section Styles{
    @* <link href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"> *@
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Add Tour Itinerary</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-10">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Tour<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m=>m.TourId, (ViewBag.AllTour as IEnumerable<SelectListItem>), new {@class="default-select size-1 form-control wide mb-3"})
                            </div>
                        </div>
@* 
                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Day<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m=>m.Day, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Day,null,new{@class="field-validation-valid text-danger"})
                            </div>
                        </div> *@

                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Image<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">

                                @Html.DropDownListFor(m=>m.ImageId, (ViewBag.allImages as IEnumerable<SelectListItem>), new {@class="default-select size-1 form-control wide mb-3",id="setImage"})
                            </div>
                            <div class="col-sm-3">
                                <img src="~/images/no-image.jpg" id="previewimage" height="200" width="150" />

                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Itinerary<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m=>m.Itinery, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Itinery,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                    
               

                
                        @* ItineryDetails *@
                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>Itinerary Details<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.ItineryDetails,new {@class="form-control",@id="summernote"})

                                @Html.ValidationMessageFor(m => m.ItineryDetails,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                   

                

                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>

                            </div>
                            <div class="col-md-4">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-2">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","TourItinerary")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>
                    }
                </div>
                

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script>
        var imageUrl = '@Url.Action("image","TourItinerary",new {imageId = "__ImageId"})'
        $(document).ready(function () {
            $('#setImage').on('change', function () {
                if ($(this).val() != '') {
                    var imageId = $.trim($(this).val())
                    var newImageUrl=imageUrl.replace('__ImageId',imageId);
                    $('#previewimage').attr('src',newImageUrl);

                }
            });
            $('#summernote').summernote({
                height: 300
            });


        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                            var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","TourItinerary")');
                            window.location.href = url;
                    });
                }
            }
        });
    </script>
}
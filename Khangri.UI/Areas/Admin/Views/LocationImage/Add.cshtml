@using Khangri.UI.Helpers;
@using Khangri.UI.Models
@model LocationImageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Location Image";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Add Location Image</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-8">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Image<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                <select class="default-select size-1 form-control wide mb-3" id="imagedropdown">
                                    @foreach (var item in ViewBag.AllImages as IEnumerable<ImageSelectListItem>)
                                    {
                                        <option value="@item.Value" data-imagesrc="@item.ImageUrl">@item.Text</option>
                                    }
                                </select>

                                @Html.ValidationMessageFor(m => m.ImageId,null,new{@class="field-validation-valid text-danger"})
                                @Html.HiddenFor(m=>m.ImageId, new {id="hdnImageId"})
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Location<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">

                                @Html.DropDownListFor(m=>m.LocationId, (ViewBag.AllLocations as IEnumerable<SelectListItem>), new {@class="default-select size-1 form-control wide mb-3"})
                                @Html.ValidationMessageFor(m => m.LocationId,null,new{@class="field-validation-valid text-danger"})

                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Caption<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Caption, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Caption,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","LocationImage")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>


                    }
                </div>


            </div>
        </div>
    </div>
</div>
@section Scripts {
    @*<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.rawgit.com/prashantchaudhary/ddslick/master/jquery.ddslick.min.js"></script>*@
    <script src="~/Admin/js/jquery.ddslick.min.js"></script>
    <script>
        $(document).ready(function () {
            var imageJsonc = '';
            @{
                var imageJson = ViewBag.ImageJson?.ToString();
                
            }
                imageJsonc = JSON.parse('@Html.Raw(imageJson)');

            if ($.trim($('#hdnImageId').val()) != '') {
                $('#imagedropdown').val($.trim($('#hdnImageId').val()));
            }

            $('#imagedropdown').find('option').each(function(idx, elem) {
                for (var i = 0; i < imageJsonc.length; i++) {
                    if ($.trim($(elem).attr('value')) == $.trim(imageJsonc[i].Id)) {
                        $(elem).attr('data-imagesrc', imageJsonc[i].ImageUrl);
                            break;
                    }
                }
            });
            $('#imagedropdown').ddslick({
                height:300,
                onSelected: function (selectedData) {
                    var val = $.trim(selectedData.selectedData.value);
                    $('#hdnImageId').val(val);
                    $('#imagedropdown').val(val);
                }
            });
        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

              var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","LocationImage")');
                            window.location.href = url;
                    });
                }
            }
        });
    </script>
}
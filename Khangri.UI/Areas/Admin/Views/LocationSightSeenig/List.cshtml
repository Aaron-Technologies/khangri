@using Khangri.Entities
@model List<EntityLocationSightSeeing>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Location Sightseeing";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">Location Sightseeing</h4>
            <a href="@Url.Action("add","LocationSightSeenig")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>

        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_locationSightSeenig" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">Location</th>
                            <th class="fw-bold">Sight Seen</th>
                            <th class="fw-bold">Ditance</th>
                            <th class="fw-bold">Status</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var items in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">@items.Location</td>

                                <td class="align-middle">
                                    @items.SightSeen
                                </td>
                                <td class="align-middle">
                                    @items.DistanceFromLocation
                                </td>

                                <td class="align-middle">
                                    @if (items.IsActive)
                                    {
                                        <span class="badge light badge-success p-5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge light badge-danger p-5">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <a href="@Url.Action("edit","LocationSightSeenig",new {locationSightSeenigId=items.LocationSightSeeingId})" class="btn btn-primary btn-sm"><i class="fa  fa-pencil-square fa-2x"></i></a>
                                        @* <button data-deleteurl="@Url.Action("delete","ShipType",new {ShipTypeId = ship.ShipTypeId})" class="btn btn-danger shadow btn-xs sharp btn-delete"><i class="fas fa-trash-alt"></i></button>*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tbl_locationSightSeenig').DataTable({
                pageLength: 10
            });
        });
    </script>
}

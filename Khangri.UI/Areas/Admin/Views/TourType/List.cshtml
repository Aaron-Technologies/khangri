@using Khangri.Entities
@model List<EntityTourType>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tour Type";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">Tour Type</h4>
            <a href="@Url.Action("add","TourType")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>
       
        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_Location" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">Tour Type</th>
                            <th class="fw-bold">Description</th>
                            <th class="fw-bold">Status</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tourType in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">@tourType.TourType</td>
                               <td>
                                    @tourType.Description
                                </td>
                               
                                <td class="align-middle">
                                    @if (tourType.IsActive)
                                    {
                                        <span class="badge light badge-success p-5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge light badge-danger p-5">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <a href="@Url.Action("edit","TourType",new {tourTypeId = tourType.TourTypeId})" class="btn btn-primary btn-sm"><i class="fa  fa-pencil-square fa-2x"></i></a>
                                        @* <button data-deleteurl="@Url.Action("delete","ShipType",new {ShipTypeId = ship.ShipTypeId})" class="btn btn-danger shadow btn-xs sharp btn-delete"><i class="fas fa-trash-alt"></i></button>*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function(){
            $('#tbl_Location').DataTable({
                pageLength: 10
            });
        });
    </script>
}

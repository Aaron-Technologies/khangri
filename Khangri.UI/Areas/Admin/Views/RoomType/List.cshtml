@using Khangri.Entities
@model List<EntityRoomType>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Contact";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">Room Type</h4>
            <a href="@Url.Action("add","RoomType")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>

        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_RoomType" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">Room Type</th>
                            <th class="fw-bold">Description</th>
                            <th class="fw-bold">Price</th>
                            <th class="fw-bold">Image</th>
                            <th class="fw-bold">Status</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var roomType in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">@roomType.RoomType</td>
                                <td>
                                    @roomType.Description
                                </td>
                                <td>
                                    @roomType.Price
                                </td>
                                <td class="align-middle">
                                    <img class="mdi-rounded-corner open-modal" width="100" data-image="@roomType.ImageFile" src="@Url.Action("image","Image",new {imageId=roomType.RoomTypeId})" alt="@roomType.ImageFile">
                                </td>
                                <td class="align-middle">
                                    @if (roomType.IsActive)
                                    {
                                        <span class="badge light badge-success p-5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge light badge-danger p-5">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <a href="@Url.Action("edit","RoomType",new {roomTypeId = roomType.RoomTypeId})" class="btn btn-primary btn-sm"><i class="fa  fa-pencil-square fa-2x"></i></a>
                                        @* <button data-deleteurl="@Url.Action("delete","ShipType",new {ShipTypeId = ship.ShipTypeId})" class="btn btn-danger shadow btn-xs sharp btn-delete"><i class="fas fa-trash-alt"></i></button>*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tbl_Counter').DataTable({
                pageLength: 10
            });
        });
    </script>
}

@using Khangri.Entities;
@model TourTermsConditionViewModel;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New Terms&Conditions";
}
@section Styles{
    @* <link href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"> *@
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Add Terms & Condition</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>TourType<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m=>m.TourTypeId, (ViewBag.AllTourType as IEnumerable<SelectListItem>), new {@class="default-select size-1 form-control wide mb-3"})
                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>Accommodation<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.Accommodation,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.Accommodation,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>


                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>Food<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.Food,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.Food,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                      
                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>TermsConditionsPermits<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.TermsConditionsPermits,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.TermsConditionsPermits,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>MiscellaneousExpenses<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.MiscellaneousExpenses,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.MiscellaneousExpenses,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>TermsConditionsGeneral<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.TermsConditionsGeneral,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.TermsConditionsGeneral,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-12 col-form-label">
                                <span>CancellationPolicy<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-10">
                                @Html.TextAreaFor(m=>m.CancellationPolicy,new {@class="form-control summernote"})

                                @Html.ValidationMessageFor(m => m.CancellationPolicy,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>


                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>

                            </div>
                            <div class="col-md-4">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-2">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","TourTermsCondition")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>
                    }
                </div>


            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script>
        var imageUrl = '@Url.Action("image","TourItinerary",new {imageId = "__ImageId"})'
        $(document).ready(function () {
            $('#setImage').on('change', function () {
                if ($(this).val() != '') {
                    var imageId = $.trim($(this).val())
                    var newImageUrl = imageUrl.replace('__ImageId', imageId);
                    $('#previewimage').attr('src', newImageUrl);

                }
            });
            $('.summernote').summernote({
                height: 200
            });


        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                                    var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "success",
                        button: "Ok",
                    }, function () {
                        var url = $.trim('@Url.Action("list","TourTermsCondition")');
                        window.location.href = url;
                    });
                }
            }
        });
    </script>
}
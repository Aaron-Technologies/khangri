@using Khangri.UI.Models;
@model SliderImageViewModel;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New Slider-Image";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Add Slider Image & Details</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {



                        <div class="form-group row">
                            <div class="col-md-3 ">
                                <span>Image File@*<span class="required">*</span>*@ :</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.ImageName, new {id="txtImageFile", @readonly="readonly",@class="form-control"})
                                    <div class="input-group-append">
                                        <label for="image-upload">

                                            <span class="btn btn-primary input-group-btn">
                                                <i class="fa fa-upload"></i>
                                            </span>
                                        </label>
                                    </div>

                                    <br />
                                    @Html.ValidationMessageFor(m => m.ImageName,null,new{@class="field-validation-valid text-danger"})
                                    <input type="file" name="FileDetails" style="height:0px;width:0px;position:absolute;top:-10px;left:-10px;visibility:collapse;"
                                           id="image-upload" accept="image/*">      
                                   
                                </div>

                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Caption:</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Caption, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Caption,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Details1:</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextAreaFor(m=>m.Details1,4, 50,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Details1,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Details2:</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextAreaFor(m=>m.Details2,4, 50,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Details2,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        @* <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Link1:</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Link1, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Link1,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@

                        @* <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Link2:</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Link2, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Link2,null,new{@class="field-validation-valid text-danger"})

                            </div>

                        </div> *@

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>

                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","SliderImage")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>


                    }
                </div>
                <div class="col-sm-6">
                    <img src="~/images/no-image.jpg" id="previewimage" height="200" width="150" />
                </div>

            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>
        $(document).ready(function () {
            $('#image-upload').on('change', function () {
                if ($(this).val() != '') {
                    var fileName = $.trim($(this).val());
                    if (fileName.indexOf('\\') > -1) {
                        var fileParts = fileName.split('\\');
                        var fileNameOnly = fileParts[fileParts.length - 1];
                        $('#txtImageFile').val(fileNameOnly);

                        const file = this.files[0];

                        if (file) {
                            let reader = new FileReader();
                            reader.onload = function (event) {
                                console.log(event.target.result);
                                $('#previewimage').attr('src', event.target.result);
                            }
                            reader.readAsDataURL(file);
                        }
                    }

                }
            });


        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                            var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","SliderImage")');
                            window.location.href = url;
                        });
                }
            }
        });
    </script>

   
}
@using Khangri.Entities;
@model EntitySightSeeing
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Sightseeing";
}
@section Styles{
    <link href="~/css/datepicker.css" rel="stylesheet" />
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Edit Sightseeing </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Sight Name<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.SightSeeing, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.SightSeeing,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        @* <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Estimate Time :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.EstimateTime, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.EstimateTime,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@

                        <div class="form-group row">
                            <div class="col-md-4 ">
                                <span>Image File<span class="required">*</span> :</span>

                            </div>
                            <div class="col-md-8">
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.ImageFile, new {id="txtImageFile", @readonly="readonly",@class="form-control"})
                                    <div class="input-group-append">
                                        <label for="image-upload">

                                            <span class="btn btn-primary input-group-btn">
                                                <i class="fa fa-upload"></i>
                                            </span>
                                            </label>
                                    </div>



                                    <br />
                                    <input type="file" name="FileDetails" style="height:0px;width:0px;position:absolute;top:-10px;left:-10px;visibility:collapse;"
                                           id="image-upload" accept="image/*">
                                </div>
                                @Html.ValidationMessageFor(m => m.ImageFile,null,new{@class="field-validation-valid text-danger"})

                            </div>
                        </div>

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Details <br> (max 45 words)<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextAreaFor(m=>m.Details,4, 50,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Details,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        @* <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Altitude :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Altitude, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Altitude,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@
                      
                        @* <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>GoogleMapUrl :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.GoogleMapUrl, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.GoogleMapUrl,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@

                        <div class="form-group row">
                            <div class="col-md-4 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","SightSeeing")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>


                    }
                </div>
                <div class="col-sm-6">
                    <img src="~/images/no-image.jpg" id="previewimage" height="200" width="150" />

                </div>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/moment/moment.min.js"></script>
    <script src="~/js/bootstrap-datepicker.js"></script>
    <script>
    $(document).ready(function(){
        $('#image-upload').on('change', function () {
                if ($(this).val() != '') {
                    var fileName = $.trim($(this).val());
                    if (fileName.indexOf('\\') > -1) {
                        var fileParts = fileName.split('\\');
                        var fileNameOnly = fileParts[fileParts.length - 1];
                        $('#txtImageFile').val(fileNameOnly);

                        const file = this.files[0];

                        if (file) {
                            let reader = new FileReader();
                            reader.onload = function (event) {
                                console.log(event.target.result);
                                $('#previewimage').attr('src', event.target.result);
                            }
                            reader.readAsDataURL(file);
                        }
                    }

                }
            });
            $('#time').datepicker();

        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                    var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","SightSeeing")');
                            window.location.href = url;
                    });
                }
            }
    });
    </script>
}

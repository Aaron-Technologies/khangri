@using Khangri.Entities
@model List<EntityCMSContent>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "CMSContent";
}
@section Styles{
    @* <link href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"> *@
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">

}
<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">CMSContent</h4>
            <a href="@Url.Action("add","CMSContent")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>

        <div class="box-body">
            <div class="row">
               <div class="col-md-4">
                    <select class="default-select size-1 form-control wide mb-3" id="ddlFilter">
                                @{
                                    foreach (var item in ViewBag.FilterItems as List<SelectListItem>)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                    </select>
               </div> 
               <div class="col-md-6">
                    <button type="button" id="btn-filter" class="btn btn-success" disabled="disabled">Submit</button>
               </div>
            </div>
           

            <div class="row" id="conten-section" style="display:none;">
            <div class="row">
                <div class="form-group row">
                    <div class="col-md-2 col-form-label">
                        <span>Content<span class="text-danger">*</span> :</span>
                    </div>
                    <div class="col-md-8" id="summernote">

                    </div>

                </div>

            </div>
            <div class="row">
                <div class="col-md-4">
                </div>
                <div class="col-md-8">
                    <button class="btn btn-success" id="save-note">Save</button>
                </div>
            </div>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            
            $('#conten-section').hide();
            //$('#summernote').summernote({
            //    height: 300

            //});
            $('#ddlFilter').on('change', function () {
                var val = $.trim($(this).val());
                if (val == "0") {
                    $('#btn-filter').attr('disabled', 'disabled');

                }
                else {
                    $('#btn-filter').removeAttr('disabled');
                }
            });;
            $('#btn-filter').on('click', function () {
                $.ajax({
                    url: '@Url.Action("PageData","CMSContent")',
                    type: 'POST',
                    data: JSON.stringify({
                        // setup:{
                        pageId: $.trim($('#ddlFilter').val())
                        // }
                    }),
                    contentType: 'application/json',
                    beforeSend: function () {
                        $("#overlay").fadeIn(300);
                        $('#summernote').summernote({
                            height:300,
                            width:600,
                            reset:'reset'
                        });

                    },
                    success: function (response) {
                        $("#overlay").fadeOut(300);
                        if (response.status == "Failed") {
                            swal({
                                title: data.Title,
                                text: data.Description,
                                type: "error",
                                button: "Ok",
                            });

                        } else {
                            $('#conten-section').show();
                            $('#summernote').summernote("pasteHTML", response.data.content)
                        }

                    },
                    error: function () {

                    },
                    complete: function () {
                        $("#overlay").fadeOut(300);
                    }

                })
            });


            $('#save-note').on('click', function () {
                $.ajax({
                    url: '@Url.Action("SaveData","CMSContent")',
                    type: 'POST',
                    data: JSON.stringify({
                        // setup:{
                        CMSPageId: $.trim($('#ddlFilter').val()),
                        content: $.trim($('#summernote').summernote().val()),
                        // }
                    }),
                    contentType: 'application/json',
                    success: function (data) {
                        if (data.status == 'Failed') {
                            swal({
                                title: data.title,
                                text: data.description,
                                type: "error",
                                button: "Ok",
                            });
                        } else if (data.status == 'Success') {
                            swal({
                                title: data.title,
                                text: data.description,
                                type: "success",
                                button: "Ok",
                            }, function () {
                                var url = $.trim('@Url.Action("list","CMSContent")');
                                window.location.href = url;
                            });
                        }

                    },
                    error: function () {

                    },
                    beforeSend: function () {
                        $("#overlay").fadeIn(300);
                        //$('#summernote').empty().text('');

                    },
                    complete: function () {
                        $("#overlay").fadeOut(300);
                    }

                })
            });
        });
    </script>
}

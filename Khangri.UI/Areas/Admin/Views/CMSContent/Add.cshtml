@using Khangri.Entities;
@model EntityCMSContent;
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New CMSContent";
}
@section Styles{
    @* <link href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"> *@
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Edit CMSContent</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-12">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {

                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Title<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-4">
                                @Html.DropDownListFor(m=>m.CMSPageId,(ViewBag.AllCMSPages as IEnumerable<SelectListItem>), new {@class="default-select size-1 form-control wide mb-3"})

                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-2 col-form-label">
                                <span>Content<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextAreaFor(m=>m.Content,new {@class="form-control",@id="summernote"})

                                @Html.ValidationMessageFor(m => m.Content,null,new{@class="field-validation-valid text-danger"})
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","CMSContent")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>


                    }
                </div>
                

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
    <script>
        $(document).ready(function () {

            $('#summernote').summernote({
                height: 300
            });

        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                                    var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                            title: data.Title,
                            text: data.Description,
                            type: "success",
                            button: "Ok",
                        }, function(){
                            var url = $.trim('@Url.Action("list","CMSContent")');
                            window.location.href = url;
                    });
                }
            }
        });
    </script>
}
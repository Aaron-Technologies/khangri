@using Khangri.UI.Models
@model LocationViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Location";
}
<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Edit Location</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-7">

                    @using (Html.BeginForm(FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Parent Location@*<span class="text-danger">*</span>*@ :</span>
                            </div>
                            <div class="col-md-8">

                                @Html.DropDownListFor(m=>m.M01_LocationId, (ViewBag.AllLocations as IEnumerable<SelectListItem>),new {@class="default-select size-1 form-control wide mb-3"})
                                @Html.ValidationMessageFor(m => m.M01_LocationId,null,new{@class="field-validation-valid text-danger"})

                            </div>
                        </div>
                        
                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Caption<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Caption, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Caption,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Location<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Location, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Location,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                      
                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Description <br> (max 100 words) <span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextAreaFor(m=>m.Description,4, 50,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Description,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>
                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Altitude<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.Altitude, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.Altitude,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div>

                        <div class="form-group row">
                            <div class="col-md-3">
                                <span>Image File@*<span class="required">*</span>*@ :</span>

                            </div>
                            <div class="col-md-5">
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.ImageFiles, new {id="txtImageFile", @readonly="readonly",@class="form-control"})
                                    <div class="input-group-append">
                                        <label for="image-upload">
                                            <span class="btn btn-primary input-group-btn">
                                                <i class="fa fa-upload"></i>
                                            </span>
                                        </label>
                                    </div>
                                    <br />
                                    <input type="file" name="FileDetails" style="height:0px;width:0px;position:absolute;top:-10px;left:-10px;visibility:collapse;"
                                           id="image-upload" accept="image/*">

                                </div>
                                @Html.ValidationMessageFor(m => m.ImageFiles,null,new{@class="field-validation-valid text-danger"})

                            </div>
                            <div class="col-sm-3">
                                    <img src="@Url.Action("image","Location",new{locationId=Model.LocationId})" id="previewimage" height="150" width="150" />
                            </div>

                        </div>


                        @* <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>WeatherUrl<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.WeatherUrl, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.WeatherUrl,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@
                        @* <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>GoogleMapUrl<span class="text-danger">*</span> :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.GoogleMapUrl, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.GoogleMapUrl,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@
                        @* <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>TripAdvisorUrl :</span>
                            </div>
                            <div class="col-md-8">
                                @Html.TextBoxFor(m=>m.TripAdvisorUrl, null,new {@class="form-control"})

                                @Html.ValidationMessageFor(m => m.TripAdvisorUrl,null,new{@class="field-validation-valid text-danger"})
                            </div>

                        </div> *@
                        

                        <div class="form-group row">
                            <div class="col-md-3 col-form-label">
                                <span>Active:</span>
                                <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-8">
                                <div class="checkbox custom-checkbox mb-3 checkbox-success check-lg">
                                    @Html.CheckBoxFor(m => m.IsActive, new {@class="filled-in chk-col-green", id="chkActive"})
                                    <label class="form-check-label" for="chkActive"></label>
                                </div>

                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-3">
                            </div>
                            <div class="col-md-8">
                                <button type="submit" class="btn btn-success">Submit</button>&nbsp;&nbsp<a href="@Url.Action("list","Location")" class="btn btn-success">Cancel</a>
                            </div>
                        </div>


                    }
                </div>

            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script>
        $(document).ready(function () {
            $('#image-upload').on('change', function () {
                if ($(this).val() != '') {
                    var fileName = $.trim($(this).val());
                    if (fileName.indexOf('\\') > -1) {
                        var fileParts = fileName.split('\\');
                        var fileNameOnly = fileParts[fileParts.length - 1];
                        $('#txtImageFile').val(fileNameOnly);

                        const file = this.files[0];

                        if (file) {
                            let reader = new FileReader();
                            reader.onload = function (event) {
                                console.log(event.target.result);
                                $('#previewimage').attr('src', event.target.result);
                            }
                            reader.readAsDataURL(file);
                        }
                    }

                }
            });

            $('#slider-image-upload').on('change', function () {
                if ($(this).val() != '') {
                    var fileName = $.trim($(this).val());
                    if (fileName.indexOf('\\') > -1) {
                        var fileParts = fileName.split('\\');
                        var fileNameOnly = fileParts[fileParts.length - 1];
                        $('#sliderImageFile').val(fileNameOnly);

                        const file = this.files[0];

                        if (file) {
                            let reader = new FileReader();
                            reader.onload = function (event) {
                                console.log(event.target.result);
                                $('#previewsliderimage').attr('src', event.target.result);
                            }
                            reader.readAsDataURL(file);
                        }
                    }

                }
            });

        @{
            var json = ViewBag.Status?.ToString();
            if (!String.IsNullOrWhiteSpace(json))
            {
                json = HttpUtility.JavaScriptStringEncode(json);
            }
        }

                                            var msg = '@Html.Raw(json)';
            if (msg != null && msg != undefined && $.trim(msg) != '') {
                var data = JSON.parse(msg);
                if (data.Status == 'Failed') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "error",
                        button: "Ok",
                    });
                } else if (data.Status == 'Success') {
                    swal({
                        title: data.Title,
                        text: data.Description,
                        type: "success",
                        button: "Ok",
                    }, function () {
                        var url = $.trim('@Url.Action("list","Location")');
                        window.location.href = url;
                    });
                }
            }
        });
    </script>
}
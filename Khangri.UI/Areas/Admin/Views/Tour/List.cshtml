@using Khangri.Entities
@model List<EntityTour>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tour";
}

<div class="col-12">
    <div class="box">
        <div class="card-header">
            <h4 class="card-title">Tour</h4>
            <a href="@Url.Action("add","Tour")" class="btn btn-primary btn-lg float-right">Add New</a>
        </div>

        <div class="box-body">
            <div class="table-responsive">
                <table id="tbl_Tour" class="table table-bordered table-striped">
                    <thead>
                        <tr role="row">
                            <th class="fw-bold">Tour Name</th>
                            <th class="fw-bold">Introduction</th>
                            <th class="fw-bold">Days</th>
                            <th class="fw-bold">Price</th>
                            <th class="fw-bold">Status</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tour in Model)
                        {
                            <tr role="row">
                                <td class="align-middle">
                                    @tour.TourName
                                </td>
                                <td class="align-middle">
                                    @tour.TourInroduction
                                </td>
                                <td class="align-middle">
                                    @tour.NoOfDays
                                </td>
                                <td class="align-middle">
                                    @tour.Price
                                </td>
                                <td class="align-middle">
                                    @if (tour.IsActive)
                                    {
                                        <span class="badge light badge-success p-5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge light badge-danger p-5">Inactive</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <a href="@Url.Action("edit","Tour",new {tourId=tour.TourId,tourTypeId = tour.TourTypeId})" class="btn btn-primary btn-sm"><i class="fa  fa-pencil-square fa-2x"></i></a>
                                        @* <button data-deleteurl="@Url.Action("delete","ShipType",new {ShipTypeId = ship.ShipTypeId})" class="btn btn-danger shadow btn-xs sharp btn-delete"><i class="fas fa-trash-alt"></i></button>*@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Admin/assets/vendor_components/datatables.net/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tbl_Tour').DataTable({
                pageLength: 10
            });
        });
    </script>
}

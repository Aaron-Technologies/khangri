                <div class="tab-content" id="v-pills-tabContent">
                    <div class="tab-pane fade show active" id="v-pills-information" role="tabpanel"
                         aria-labelledby="v-pills-information-tab">
                        <div class="tour-information">
                            <div class="tour-price">
                                <h3>Overview</h3>
                            </div>

                            <p>
                                @Model.Tours.TourInroduction
                            </p>
                           
                        </div>
                    </div>
                    <div class="tab-pane fade" id="v-pills-plan" role="tabpanel" aria-labelledby="v-pills-plan-tab">
                        <div class="tour-plan">
                            <h3 class="tour-details-subtitle">Trekking Plan</h3>
                            <div>
                                <p class="title">Duration: @Model.Tours.NoOfDays Days @(Model.Tours.NoOfDays - 1) Nights</p>
                                @{
                                    foreach (var item in Model.TourItinerary)
                                    {

                                        <div class="tour-plan-single">
                                            <div class="plan-content">
                                                <h4 class="plan-title">@item.Itinery</h4>
                                                <div>
                                                    @Html.Raw(item.ItineryDetails)
                                                </div>
                                            </div>
                                        </div>

                                    }
                                }

                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="v-pills-inc" role="tabpanel" aria-labelledby="v-pills-gallery-tab">
                        <div class="tour-gallery-wrap">
                            <h3 class="tour-details-subtitle"> </h3>

                            <div class="row justify-content-center g-4">
                                <div class="col-md-6 col-sm-10 ">
                                    <div class="facility-single2 text-start">
                                        <div class="facility-content">
                                            <h4>Inclusion</h4>
                                            <div class="alpine-info-wrap pb-0 mb-0">
                                                @Html.Raw(Model.Tours.TourHighlight)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-10 ">
                                    <div class="facility-single2 text-start">
                                        <div class="facility-content">
                                            <h4>Exclusion</h4>
                                            <div class="alpine-info-wrap pb-0 mb-0">
                                                @Html.Raw(Model.Tours.TourOverview)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-lg-4">
            </div>
        </div>
    </div>
</div>


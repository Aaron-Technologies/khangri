@using Khangri.UI.Models
@model TourdetailsViewModel
@{
    ViewData["Title"] = "Khangri Tour & Trek";
}
@{
    ViewData["Description"] = "Embark on unforgettable journeys with our premier tour and travel agency. Explore diverse destinations, create lasting memories, and book your next adventure today!";
}

@section styles {
    <style>
        .inner-banner-vector{
            z-index: 0 !important;
        }
    </style>
}

<div class="inner-banner-section sibling-2">
    <img src="@Url.Action("image","Image",new{imageId=Model.Tours.M20_ImageId})" class="inner-banner-vector" alt="image">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-md-10 col-sm-12">
                <div class="breadcrumb-area">
                    @* <span>Amazing Trek</span> *@
                    <h2>@Model.Tours.TourName</h2>
                    <!-- <div class="review-area">
                      <ul class="star-list">
                        <li><i class="bi bi-star-fill"></i></li>
                        <li><i class="bi bi-star-fill"></i></li>
                        <li><i class="bi bi-star-fill"></i></li>
                        <li><i class="bi bi-star-fill"></i></li>
                        <li><i class="bi bi-star-half"></i></li>
                      </ul>
                      <span>(10 Review)</span>
                    </div> -->
                </div>
            </div>
        </div>
    </div>
</div>



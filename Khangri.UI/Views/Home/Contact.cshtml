@using Khangri.UI.Models
@model HomeViewModel


<div class="inner-banner-section">
    <img src="~/assets/images/bg/inner-banner-vctr.png" class="inner-banner-vector" alt="image">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-8 col-md-10 col-sm-12">
          <div class="breadcrumb-area">
            <span>Khangri Tour & Trek</span>
            <h2>Contact</h2>
          </div>
        </div>
      </div>
    </div>
</div>

<div class="info-section pt-120 pb-120">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-7 col-md-10 col-sm-12">
          <div class="info-title-area">
            <h3>Khangri Tour & Trek</h3>
            <p>
              Khangri Tours & Treks a leading inbound tour operating company registered and recognized by the Department of Tourism,
              Govt. of Sikkim, with coordinating counterparts in neighbouring countries like Nepal, Bhutan and within India for our
              movements, In Sikkim it is managed by all local youths with a team of hand picked young professionals who understand
              service industry very well. 
            </p>
          </div>
        </div>
      </div>
      <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6 col-sm-10">
          <div class="info-single">
            <div class="info-icon">
              <i class="bx bx-phone-call"></i>
            </div>
            <div class="info-text">
              <h3>Call Us!</h3>
              <a href="tel:9832049994" target="_blank">98320-49994</a>
              <a href="tel:9474649449" target="_blank">94746-49449</a>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-10">
          <div class="info-single">
            <div class="info-icon">
              <i class="bi bi-geo-alt"></i>
            </div>
            <div class="info-text">
              <h3>Address</h3>
              <p>Khangri Building, Behind Axis Bank, M.G Marg, Gangtok East-Sikkim 737101</p>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-10">
          <div class="info-single">
            <div class="info-icon">
              <i class="bx bx-envelope"></i>
            </div>
            <div class="info-text">
              <h3>Email Info</h3>
              <a href="mailto:khangritrek@yahoo.com"><span class="__cf_email__">khangritrek@yahoo.com</span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>



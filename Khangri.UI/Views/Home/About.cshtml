@using Khangri.UI.Models
@model HomeViewModel


<div class="inner-banner-section">
    <img src="~/assets/images/bg/inner-banner-vctr.png" class="inner-banner-vector" alt="image">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-xl-8 col-md-10 col-sm-12">
          <div class="breadcrumb-area">
            <span> We are best tour & treks agency.  </span>
            <h2>Khangri Tour & Treks</h2>
          </div>
        </div>
      </div>
    </div>
</div>


<div class="feature-section2 pt-120">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6 ps-lg-5">
          <div class="about3-title text-start">
            <p>Khangri Tours & Treks a leading inbound tour operating company registered and recognized by the Department of Tourism, Govt. of Sikkim, with coordinating counterparts in neighbouring countries like Nepal, Bhutan and within India for our movements, In Sikkim it is managed by all local youths with a team of hand picked young professionals who understand service industry very well. Although we have many different itineraries covering the entire spectrum of eastern Himalayas and all the pilgrimage sites but our goal is to move away from “ONE SIZE, FITS ALL” approach and customize our services to each individuals needs. Hence we are very flexible and make a 
            tailor tour to suit your market. Our company offers tours in India, broadly  covering.</p>
          </div>
          <ul class="feature3-list sibling-2">
            <li>Culture Tours to India</li>
            <li>Plgrimage & Enlightenment Journeys</li>
            <li>Angling and bird watching tours</li>

          </ul>
          <a href="@Url.Action("list","TourDetails")" class="eg-btn btn--primary-outline sibling-2 btn--lg">Find tours</a>
        </div>
        <div class="col-lg-6">
          <div class="feature-image-group d-flex flex-row justify-content-center gap-5">
            <div class="feature3-icon">
              <img src="~/~/assets/images/icons/feature3-icon.svg" alt>
            </div>
            <div class="feature-image">
              <img src="~/assets/images/custom/about1.jpg" class="img-fluid" alt="image">
            </div>
            <div class="feature-image translate-y">
              <img src="~/assets/images/custom/about2.jpg" class="img-fluid" alt="image">
            </div>
          </div>
        </div>
      </div>
    </div>
</div>



@using Khangri.UI.Models
@model HomeViewModel
@{
    ViewData["Title"] = "Khangri Tour & Trek";
}
@{
    ViewData["Description"] = "Embark on unforgettable journeys with our premier tour and travel agency. Explore diverse destinations, create lasting memories, and book your next adventure today!";
}


<div class="banner-section2">
    <div class="swiper banner2-slider">
        
      <div class="swiper-wrapper">
            @{
                foreach(var item in Model.SliderImages.OrderBy(s => s.SliderImageId))
                {
                    if (item.IsActive==true)
                    {
                        <div class="swiper-slide client">

                        </div>
                        <div class="content">
                            <h4>Sikkim Tour</h4>
                        </div>
                    </div>
                </div>
                
                <div class="col">
                    <div class="category-single1">
                        <div class="icon">
                            <img src="~/assets/images/icons/wedding.svg" alt="image">
                        </div>
                        <div class="content">
                            <h4>Trekking</h4>
                        </div>
                    </div>
                </div>
               
                <div class="col">
                    <div class="category-single1">
                        <div class="icon">
                            <img src="~/assets/images/icons/travel.svg" alt="image">
                        </div>

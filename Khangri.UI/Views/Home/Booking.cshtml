@using Khangri.UI.Models
@model HomeViewModel

<div class="destination-details-section pt-120 pb-120">
    <div class="container">
      <div class="row gy-5 justify-content-center">
        <div class="col-lg-3">
          <div class="h-100" style="background-image: url('https://www.trekkinginsikkims.com/ServerImage/92d4584c-6f57-4429-a93e-b6d658284533.webp'); background-size: cover;"></div>
        </div>
        <div class="col-lg-9">
          <div class="booking-form-box">
            <h3>Book the Tour</h3>
            <p>Arrange your trip in advance - book this tour now!</p>
            

            <div class="row g-4 justify-content-center">
              <div class="col-lg-4 col-md-6 col-sm-10">
                <div class="info-single">
                  <div class="info-icon">
                    <i class="bx bx-phone-call"></i>
                  </div>
                  <div class="info-text">
                    <h3>Call Us!</h3>
                    <a href="tel:+918116762251" target="_blank">+91 81167-62251</a>
                    <a href="tel:+919474649449" target="_blank">+91 94746-49449</a>
                  </div>
                </div>
              </div>
              <div class="col-lg-4 col-md-6 col-sm-10">
                <div class="info-single">
                  <div class="info-icon">
                    <i class="bi bi-geo-alt"></i>
                  </div>
                  <div class="info-text">
                    <h3>Address</h3>
                    <p>Khangri Building, Behind Axis Bank, M.G Marg, Gangtok East-Sikkim 737101</p>
                  </div>
                </div>
              </div>
              <div class="col-lg-4 col-md-6 col-sm-10">
                <div class="info-single">
                  <div class="info-icon">
                    <i class="bx bx-envelope"></i>
                  </div>
                  <div class="info-text">
                    <h3>Email Info</h3>
                    <a href="mailto:khangritrek@yahoo.com"><span class="__cf_email__">khangritrek@yahoo.com</span></a>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

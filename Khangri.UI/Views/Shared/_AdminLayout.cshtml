    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPage = window.location.pathname; // Get current page URL

            var navLinks = document.querySelectorAll('.treeview-menu a');

            // Loop through each navigation link
            navLinks.forEach(function (link) {
                var linkUrl = link.getAttribute('href');

                // Check if the link's href matches the current page
                if (linkUrl === currentPage) {
                    link.classList.add('active'); // Add 'active' class to the current page link
                    // Add 'active' class to the parent element (li) of the current page link
                    link.parentElement.classList.add('active');

                    // Expand the parent treeview if it's not already expanded
                    var parentTreeview = link.closest('.treeview');
                    if (parentTreeview && !parentTreeview.classList.contains('menu-open')) {
                        parentTreeview.classList.add('menu-open', 'active');
                    }
                }
            });
        });

    </script>


